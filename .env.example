# Loaded into the process environment by run.ps1. Restart after edits.
# Both segmentation and review use this provider: bailian or deepseek.
STORY_LLM_PROVIDER=deepseek

# Fixed voice for the first-person protagonist; actual character identity stays separate.
# alex resolves to Andy_v3.1 by default. Set auto only to opt into inferred voices.
STORY_FIRST_PERSON=alex
# Beth is reserved for narration. Female dialogue slots: maya, june, betty.
STORY_VOICE_NARRATOR=Beth_v3.1
STORY_VOICE_BETTY=Betty_v3.1

# All model IDs: text models are independent from the speech model.
QWEN_LLM_MODEL=qwen3.8-max
DEEPSEEK_MODEL=deepseek-flash
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash

# Replace YOUR_WORKSPACE_ID with your Bailian workspace ID (Beijing example).
# Use full endpoints, including /chat/completions for text.
QWEN_LLM_ENDPOINT=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
QWEN_TTS_ENDPOINT=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# Fill only the private .env; never commit actual keys.
# DASHSCOPE_API_KEY is used by Bailian text AND Qwen TTS.
# DEEPSEEK_API_KEY is required only when STORY_LLM_PROVIDER=deepseek.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
